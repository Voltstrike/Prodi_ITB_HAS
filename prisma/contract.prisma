// use prisma-8 
model Dosen {
  id             Int                        @id @default(autoincrement())
  nama           String
  slug           String                     @unique
  nidn           String
  foto           String?
  pendidikan     String
  profil         String?
  createdAt      TimestamptzString          @default(now())
  updatedAt      temporal.updatedAtString()
}

model Berita {
  id          Int                        @id @default(autoincrement())
  title       String
  date        String
  description String
  image       String
  slug        String                     @unique
  content     String
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}

model Kurikulum {
  id        Int      @id @default(autoincrement())
  kode      String   @unique
  nama      String
  sks       Int
  semester  Int
  jenis     String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model KalenderAkademik {
  id             Int      @id @default(autoincrement())
  kegiatan       String
  tanggalMulai   String
  tanggalSelesai String
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model InformasiAkademik {
  id        Int      @id @default(autoincrement())
  judul     String
  deskripsi String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model AdminUser {
  id           Int                        @id @default(autoincrement())
  nama         String
  email        String                     @unique
  passwordHash String
  role         String
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()
}

model AdminSession {
  id        Int                        @id @default(autoincrement())
  userId    Int
  tokenHash String                     @unique
  expiresAt TimestamptzString
  createdAt TimestamptzString         @default(now())
}

model AuditLog {
  id        Int               @id @default(autoincrement())
  userId    Int
  action    String
  entity    String
  entityId  Int
  details   String
  createdAt TimestamptzString @default(now())
}
