// use prisma-8 
model Dosen {
  id           Int                        @id @default(autoincrement())
  nama         String
  slug         String                     @unique
  nidn         String                     @unique
  foto         String?
  pendidikanS1 String?
  pendidikanS2 String?
  pendidikanS3 String?
  profil       String?
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()
}

model Staff {
  id           Int                        @id @default(autoincrement())
  nama         String
  pendidikan   String?
  jabatan      String
  lingkupKerja String?
  foto         String?
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()
}

model Berita {
  id          Int                        @id @default(autoincrement())
  title       String
  date        String
  description String
  image       String
  thumbnail   String?
  slug        String                     @unique
  content     String
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}

model Kurikulum {
  id        Int                        @id @default(autoincrement())
  kode      String                     @unique
  nama      String
  sks       Int
  semester  Int
  jenis     String
  konsentrasi String?
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

model KalenderAkademik {
  id             Int                        @id @default(autoincrement())
  kegiatan       String
  tanggalMulai   String
  tanggalSelesai String
  createdAt      TimestamptzString          @default(now())
  updatedAt      temporal.updatedAtString()
}

model InformasiAkademik {
  id        Int                        @id @default(autoincrement())
  judul     String
  deskripsi String
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

model AdminUser {
  id           Int                        @id @default(autoincrement())
  nama         String
  email        String                     @unique
  passwordHash String
  role         String
  isActive     Boolean                    @default(true)
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()
}

model AdminSession {
  mfaVersion Int @default(0)
  id        Int               @id @default(autoincrement())
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tokenHash String            @unique
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())
}

model AuditLog {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  action    String
  entity    String
  entityId  Int
  details   String
  createdAt TimestamptzString @default(now())
}

model Profil {
  id                Int                        @id @default(autoincrement())
  singletonKey      Int                        @default(1) @unique
  sejarah           String
  visi              String
  misi              String
  fotoProdi         String?
  struktur          String?
  strukturOrganisasi Jsonb?
  akreditasi        String?
  dokumenAkreditasi String?
  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()

  @@check(expression: "\"singletonKey\" = 1", name: "profil_singleton_key")
}

model LoginRateLimit {
  id             Int               @id @default(autoincrement())
  key            String            @unique
  count          Int
  firstAttemptAt TimestamptzString
  updatedAt      temporal.updatedAtString()
}

model KegiatanProdi {
  id           Int               @id @default(autoincrement())
  judul        String
  slug         String            @unique
  jenis        String
  tahun        Int
  dosenId      Int
  dosen        Dosen @relation(fields: [dosenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ringkasan    String
  uraian       String
  foto         String?
  tautanHasil  String?
  createdAt    TimestamptzString  @default(now())
  updatedAt    temporal.updatedAtString()

  @@check(expression: "\"jenis\" IN ('PENELITIAN', 'PENGABDIAN')", name: "kegiatan_prodi_jenis")
}

model DosenMataKuliah {
  id           Int @id @default(autoincrement())
  dosenId      Int
  kurikulumId  Int
  dosen        Dosen @relation(fields: [dosenId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  kurikulum    Kurikulum @relation(fields: [kurikulumId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([dosenId, kurikulumId])
}

model DokumenKurikulum {
  id        Int                        @id @default(autoincrement())
  kategori  String                     @default("KURIKULUM")
  judul     String
  filename  String                     @unique
  namaAsli  String
  ukuran    Int
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@check(expression: "\"kategori\" IN ('KURIKULUM', 'PANDUAN_TESIS', 'DESKRIPSI_KONSENTRASI')",
name: "dokumen_kurikulum_kategori")
}

model Beranda {
  id                    Int                        @id @default(autoincrement())
  singletonKey          Int                        @default(1) @unique
  fotoKegiatanKampus    String?
  fotoProdi             String?
  fotoKurikulum         String?
  fotoKalenderAkademik  String?
  fotoPendaftaran       String?
  createdAt             TimestamptzString          @default(now())
  updatedAt             temporal.updatedAtString()

  @@check(expression: "\"singletonKey\" = 1", name: "beranda_singleton_key")
}

model AdminMfa {
  id                      Int @id @default(autoincrement())
  userId                  Int @unique
  user                    AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  secretEncrypted         String?
  enabledAt               TimestamptzString?
  pendingSecretEncrypted  String?
  pendingExpiresAt        TimestamptzString?
  pendingSessionTokenHash String?
  lastUsedStep            Int?
  version                 Int @default(0)
  failedAttempts          Int @default(0)
  firstFailedAt           TimestamptzString?
  createdAt               TimestamptzString @default(now())
  updatedAt               temporal.updatedAtString()
}

model AdminMfaRecoveryCode {
  id        Int @id @default(autoincrement())
  userId    Int
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  codeHash  String @unique
  createdAt TimestamptzString @default(now())
}

model PublikasiIlmiah {
  id                Int                        @id @default(autoincrement())
  judul             String
  slug              String                     @unique
  jenis             String
  penulis           String
  tahun             Int
  sumber            String
  ringkasan         String?
  tautanPublikasi   String
  doi               String?                    @unique
  ditampilkan       Boolean                    @default(false)
  createdAt         TimestamptzString           @default(now())
  updatedAt         temporal.updatedAtString()

  @@index([ditampilkan, tahun, id])
  @@check(expression: "\"jenis\" IN ('TESIS', 'ARTIKEL')", name: "publikasi_ilmiah_jenis")
}
